# adeline-brain — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Environment ──────────────────────────────────────────────────────────────
# Set to "production" to enforce strict credential checks (no fallback defaults)
ADELINE_ENV=development

# ── PostgreSQL + pgvector (Hippocampus) ───────────────────────────────────────
POSTGRES_DSN=postgresql://adeline:adeline@localhost:5432/adeline_dev

# ── Redis (session cache + daily-bread cache) ─────────────────────────────────
# Upstash Redis REST (cloud) — preferred:
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Local Docker fallback (used when UPSTASH_REDIS_REST_URL is not set):
# REDIS_URL=redis://localhost:6379

# ── OpenAI (embeddings: text-embedding-3-small) ───────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic (lesson generation: claude-3-5-sonnet-20241022) ────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Gemini (synthesis — OpenAI-compatible endpoint) ──────────────────────────
# Falls back to Claude if not set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash          # default; use gemini-2.5-flash-lite for cheaper

# ── Witness Protocol threshold (optional override) ────────────────────────────
# WITNESS_HISTORY_THRESHOLD=0.82         # TRUTH_HISTORY only (tune 0.78–0.85)

# ── Tavily (Researcher tool — web archive search) ────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Supabase Storage (EPUB book files) ───────────────────────────────────────
# Set both to use Supabase Storage. Omit for local filesystem storage.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ───────────────────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
