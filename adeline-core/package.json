{
  "name": "@adeline/core",
  "version": "0.1.0",
  "description": "Shared types, enums, and schemas for the Dear Adeline 2.0 ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --out-dir dist",
    "dev": "tsup src/index.ts --format cjs --dts --out-dir dist --watch",
