    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ]
}
